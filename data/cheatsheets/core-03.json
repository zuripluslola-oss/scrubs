  {
   "id": "therapeutic-diets",
   "title": "Therapeutic Diets",
   "category": "Nutrition",
   "icon": "drop",
   "summary": "Which diet goes with which condition.",
   "sections": [
    {
     "h": "Texture / GI rest",
     "rows": [
      {
       "k": "Clear liquid",
       "v": "Broth, gelatin, apple juice, tea",
       "note": "Pre/post-op, acute GI upset."
      },
      {
       "k": "Full liquid",
       "v": "Adds milk, cream soups, pudding",
       "note": "Transition from clear."
      },
      {
       "k": "Low residue / low fiber",
       "v": "Limit whole grains, raw produce",
       "note": "Acute diverticulitis, IBD flare, pre-colonoscopy."
      },
      {
       "k": "High fiber",
       "v": "Whole grains, fruits, vegetables",
       "note": "Constipation, diverticulOSIS (not acute)."
      }
     ]
    },
    {
     "h": "Condition-specific",
     "rows": [
      {
       "k": "Renal (CKD)",
       "v": "Limit protein, potassium, phosphorus, sodium, fluid",
       "note": "Protects failing kidneys."
      },
      {
       "k": "Cardiac / DASH",
       "v": "Low sodium, low saturated fat",
       "note": "Heart failure, hypertension."
      },
      {
       "k": "Low purine",
       "v": "Avoid organ meats, shellfish, alcohol",
       "note": "Gout."
      },
      {
       "k": "Gluten-free",
       "v": "No wheat, barley, rye",
       "note": "Celiac disease."
      },
      {
       "k": "Consistent carbohydrate",
       "v": "Steady carbs per meal",
       "note": "Diabetes."
      }
     ]
    }
   ],
   "pearl": "On a loop/thiazide diuretic → eat MORE potassium (bananas, oranges). On potassium-sparing or CKD → eat LESS."
  },
  {
   "id": "defense-mechanisms",
   "title": "Defense Mechanisms",
   "category": "Mental Health",
   "icon": "chat",
   "summary": "The ego defenses and a quick example of each.",
   "sections": [
    {
     "h": "Common",
     "rows": [
      {
       "k": "Denial",
       "v": "Refusing to accept reality",
       "note": "“I don’t have a drinking problem.”"
      },
      {
       "k": "Repression",
       "v": "Unconsciously blocking memories",
       "note": "Forgetting a traumatic event."
      },
      {
       "k": "Regression",
       "v": "Reverting to earlier behavior",
       "note": "A hospitalized child wetting the bed."
      },
      {
       "k": "Projection",
       "v": "Attributing own feelings to others",
       "note": "“You’re the one who’s angry, not me.”"
      },
      {
       "k": "Displacement",
       "v": "Redirecting feelings to a safer target",
       "note": "Yelling at family after a bad day at work."
      }
     ]
    },
    {
     "h": "Higher-level / other",
     "rows": [
      {
       "k": "Rationalization",
       "v": "Justifying with logical excuses",
       "note": "“I failed because the test was unfair.”"
      },
      {
       "k": "Sublimation",
       "v": "Channeling urges into acceptable outlets",
       "note": "Aggression → competitive sports (healthiest)."
      },
      {
       "k": "Reaction formation",
       "v": "Acting opposite to true feelings",
       "note": "Being overly kind to someone you dislike."
      },
      {
       "k": "Compensation",
       "v": "Offsetting a weakness with a strength",
       "note": "Poor athlete excels academically."
      },
      {
       "k": "Undoing",
       "v": "Trying to cancel out an act",
       "note": "Buying a gift after an argument."
      }
     ]
    }
   ],
   "pearl": "Sublimation is the healthiest/most mature defense. Denial is often the first response to loss."
  },
  {
   "id": "prioritization",
   "title": "Prioritization Frameworks",
   "category": "Management",
   "icon": "sheet",
   "summary": "The rules for deciding who and what comes first.",
   "sections": [
    {
     "h": "Order of frameworks",
     "rows": [
      {
       "k": "1. ABCs",
       "v": "Airway → Breathing → Circulation",
       "note": "Always first; airway beats everything."
      },
      {
       "k": "2. Maslow",
       "v": "Physiological before psychosocial",
       "note": "Oxygen/food/safety before self-esteem."
      },
      {
       "k": "3. Safety / risk",
       "v": "Prevent harm",
       "note": "Falls, errors, infection."
      },
      {
       "k": "4. Acute vs chronic",
       "v": "Acute and unstable first",
       "note": "New problems over long-standing ones."
      }
     ]
    },
    {
     "h": "Decision cues",
     "rows": [
      {
       "k": "Nursing process",
       "v": "Assess before you act",
       "note": "When unsure, the answer is often 'assess/gather more data.'"
      },
      {
       "k": "Least restrictive",
       "v": "Try the least restrictive option first",
       "note": "Especially restraints and psych care."
      },
      {
       "k": "Unstable over stable",
       "v": "See the deteriorating client first",
       "note": "Predictable/stable clients can wait."
      }
     ]
    }
   ],
   "pearl": "If two clients both seem urgent, pick the one with the airway/breathing problem or the newest, most unstable change."
  },
  {
   "id": "delegation",
   "title": "Delegation & Scope of Practice",
   "category": "Management",
   "icon": "sheet",
   "summary": "Who can safely do what — RN vs LPN/LVN vs UAP.",
   "sections": [
    {
     "h": "Registered Nurse (RN) only",
     "rows": [
      {
       "k": "Cannot delegate",
       "v": "Assess, plan, evaluate, teach",
       "note": "The nursing judgment steps stay with the RN."
      },
      {
       "k": "Also RN",
       "v": "Unstable clients, IV push meds, blood, initial care",
       "note": "First assessment and care planning."
      }
     ]
    },
    {
     "h": "LPN / LVN",
     "rows": [
      {
       "k": "Can do",
       "v": "Stable clients, many meds, reinforce teaching, monitoring, wound care",
       "note": "Works under the RN."
      },
      {
       "k": "Cannot",
       "v": "Initial assessment, IV push (varies), care planning, unstable clients",
       "note": "Scope varies by state."
      }
     ]
    },
    {
     "h": "Unlicensed assistive personnel (UAP)",
     "rows": [
      {
       "k": "Can do",
       "v": "ADLs, hygiene, vitals (stable), I&O, ambulation, positioning, feeding",
       "note": "Routine, standard, predictable tasks."
      },
      {
       "k": "Cannot",
       "v": "Assess, teach, evaluate, anything requiring judgment",
       "note": ""
      }
     ]
    }
   ],
   "pearl": "5 Rights of Delegation: right Task, Circumstance, Person, Direction/communication, Supervision. Never delegate assess/teach/evaluate/unstable."
  },
  {
   "id": "critical-values",
   "title": "Critical / Panic Lab Values",
   "category": "Reference",
   "icon": "flask",
   "summary": "The values that mean 'call the provider now.'",
   "sections": [
    {
     "h": "Electrolytes",
     "rows": [
      {
       "k": "Potassium",
       "v": "<2.5 or >6.5 mEq/L",
       "note": "Cardiac dysrhythmias — highest priority."
      },
      {
       "k": "Sodium",
       "v": "<120 or >160 mEq/L",
       "note": "Seizures, altered mental status."
      },
      {
       "k": "Calcium",
       "v": "<6 or >13 mg/dL",
       "note": "Tetany or severe weakness."
      },
      {
       "k": "Magnesium",
       "v": "<1 or >9 mg/dL",
       "note": "Reflex and cardiac changes."
      }
     ]
    },
    {
     "h": "Other panics",
     "rows": [
      {
       "k": "Glucose",
       "v": "<40 or >400 mg/dL",
       "note": "Coma risk both directions."
      },
      {
       "k": "Platelets",
       "v": "<20,000 /mm³",
       "note": "Spontaneous bleeding."
      },
      {
       "k": "Hemoglobin",
       "v": "<7 g/dL",
       "note": "May require transfusion."
      },
      {
       "k": "INR",
       "v": ">5",
       "note": "High bleeding risk (hold warfarin, vitamin K)."
      },
      {
       "k": "pH",
       "v": "<7.2 or >7.6",
       "note": "Severe acid-base disturbance."
      }
     ]
    }
   ],
   "pearl": "Critical values require read-back and prompt provider notification — document who you told and when."
  },
  {
   "id": "increased-icp",
   "title": "Increased ICP & Neuro Checks",
   "category": "Reference",
   "icon": "sheet",
   "summary": "Early vs late signs, the GCS, and positioning.",
   "sections": [
    {
     "h": "Signs of rising ICP",
     "rows": [
      {
       "k": "Earliest",
       "v": "Decreasing level of consciousness, restlessness",
       "note": "LOC change is the most sensitive early sign."
      },
      {
       "k": "Late — Cushing's triad",
       "v": "Bradycardia, widening pulse pressure, irregular respirations",
       "note": "Ominous — impending herniation."
      },
      {
       "k": "Also late",
       "v": "Fixed/dilated pupils, posturing, vomiting",
       "note": "Decorticate (flexion) → decerebrate (extension) = worse."
      }
     ]
    },
    {
     "h": "Glasgow Coma Scale",
     "rows": [
      {
       "k": "Components",
       "v": "Eye (4) + Verbal (5) + Motor (6)",
       "note": "Max 15."
      },
      {
       "k": "≤8",
       "v": "Coma — protect the airway (intubate)",
       "note": "Lower = worse."
      }
     ]
    },
    {
     "h": "Interventions",
     "rows": [
      {
       "k": "Positioning",
       "v": "HOB 30°, head midline",
       "note": "Promotes venous drainage."
      },
      {
       "k": "Avoid",
       "v": "Neck flexion, Valsalva, suctioning >10 sec",
       "note": "These spike ICP."
      }
     ]
    }
   ],
   "pearl": "Early ICP = LOC change. Late ICP = Cushing's triad (opposite of shock: slow HR, wide pulse pressure)."
  },
  {
   "id": "blood-transfusion",
   "title": "Blood Transfusion",
   "category": "Reference",
   "icon": "drop",
   "summary": "Compatibility, reactions, and safe administration.",
   "sections": [
    {
     "h": "Compatibility",
     "rows": [
      {
       "k": "O negative",
       "v": "Universal donor",
       "note": "Given in emergencies."
      },
      {
       "k": "AB positive",
       "v": "Universal recipient",
       "note": "Can receive any type."
      },
      {
       "k": "Rh",
       "v": "Rh- clients get Rh- blood",
       "note": "Rh+ can receive either."
      }
     ]
    },
    {
     "h": "Reactions",
     "rows": [
      {
       "k": "Acute hemolytic (ABO mismatch)",
       "v": "Fever, chills, low back pain, dark urine",
       "note": "STOP immediately; saline via new tubing; the most dangerous."
      },
      {
       "k": "Febrile",
       "v": "Fever, chills (most common)",
       "note": "Stop; antipyretic."
      },
      {
       "k": "Allergic",
       "v": "Hives, itching → anaphylaxis",
       "note": "Stop; antihistamine/epinephrine."
      },
      {
       "k": "TACO (overload)",
       "v": "Dyspnea, crackles, hypertension",
       "note": "Slow/stop; diuretic; sit upright."
      }
     ]
    },
    {
     "h": "Safe administration",
     "rows": [
      {
       "k": "Verify",
       "v": "Two nurses check client + unit",
       "note": "Right blood, right client."
      },
      {
       "k": "Tubing/fluid",
       "v": "Y-tubing with 0.9% normal saline only",
       "note": "Never with dextrose or LR."
      },
      {
       "k": "Timing",
       "v": "Stay the first 15 min; infuse within 4 hours",
       "note": "Most reactions occur early."
      }
     ]
    }
   ],
   "pearl": "Any transfusion reaction: STOP the blood first, keep the line open with saline (new tubing), then assess and notify."
  },
