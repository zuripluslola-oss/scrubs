       "note": "Front 4.5 + back 4.5."
      },
      {
       "k": "Each arm",
       "v": "9%",
       "note": ""
      },
      {
       "k": "Each leg",
       "v": "18%",
       "note": ""
      },
      {
       "k": "Front torso",
       "v": "18%",
       "note": "Back torso 18%."
      },
      {
       "k": "Perineum",
       "v": "1%",
       "note": ""
      }
     ]
    },
    {
     "h": "Phases",
     "rows": [
      {
       "k": "Emergent/resuscitative",
       "v": "First 24–48 hr",
       "note": "Fluid shifts OUT (hypovolemia); watch airway & fluids."
      },
      {
       "k": "Acute",
       "v": "Until wounds close",
       "note": "Infection risk, nutrition, wound care."
      },
      {
       "k": "Rehabilitative",
       "v": "Recovery",
       "note": "Mobility, scar management, psychosocial."
      }
     ]
    },
    {
     "h": "Priorities & fluids",
     "rows": [
      {
       "k": "Airway first",
       "v": "Assess for inhalation injury",
       "note": "Singed nasal hair, soot, hoarseness, facial burns."
      },
      {
       "k": "Parkland formula",
       "v": "4 mL × kg × %TBSA (LR)",
       "note": "Half in the first 8 hr from time of injury."
      }
     ]
    }
   ],
   "pearl": "Burn priority order: Airway → Fluids (LR) → Pain → Infection prevention. Inhalation injury kills fastest."
  },
