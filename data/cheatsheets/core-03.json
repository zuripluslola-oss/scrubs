       "k": "Respiratory acidosis",
       "v": "Hypoventilation",
       "note": "COPD, opioid overdose, sedation, chest trauma."
      },
      {
       "k": "Respiratory alkalosis",
       "v": "Hyperventilation",
       "note": "Anxiety, pain, fever, early PE, high altitude."
      }
     ]
    },
    {
     "h": "Metabolic (kidneys / HCO₃)",
     "rows": [
      {
       "k": "Metabolic acidosis",
       "v": "Acid gain or bicarb loss",
       "note": "DKA, lactic acidosis/shock, diarrhea, renal failure."
      },
      {
       "k": "Metabolic alkalosis",
       "v": "Acid loss or bicarb gain",
       "note": "Vomiting, NG suction, antacids, diuretics."
      }
     ]
    }
   ],
   "pearl": "Vomiting → alkalosis (lose acid). Diarrhea → acidosis (lose bicarb). DKA → acidosis. Hyperventilating → alkalosis."
  }
 ]
