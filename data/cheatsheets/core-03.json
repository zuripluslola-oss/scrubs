  },
  {
   "id": "pressure-injury",
   "title": "Pressure Injury Staging",
   "category": "Fundamentals",
   "icon": "sheet",
   "summary": "How to stage a pressure injury correctly.",
   "sections": [
    {
     "h": "Stages",
     "rows": [
      {
       "k": "Stage 1",
       "v": "Intact skin, non-blanchable redness",
       "note": "If it blanches, it's not a pressure injury yet."
      },
      {
       "k": "Stage 2",
       "v": "Partial-thickness loss; shallow open ulcer or blister",
       "note": "Pink/red wound bed, no slough."
      },
      {
       "k": "Stage 3",
       "v": "Full-thickness; subcutaneous FAT visible",
       "note": "May have slough; no bone/muscle."
      },
      {
       "k": "Stage 4",
       "v": "Full-thickness; BONE, muscle, or tendon exposed",
       "note": "Deepest."
      }
     ]
    },
    {
     "h": "Cannot be numbered",
     "rows": [
      {
       "k": "Unstageable",
       "v": "Base covered by slough/eschar",
       "note": "Can't see the depth until debrided."
      },
      {
       "k": "Deep tissue injury",
       "v": "Persistent maroon/purple intact skin or blood blister",
       "note": "Damage below the surface."
      }
     ]
    }
   ],
   "pearl": "Stage by what you SEE: fat = 3, bone = 4, covered = unstageable. Prevention: reposition q2h, keep skin dry."
  },
