{
 "batch": "core-01",
 "sheets": [
  {
   "id": "abgs",
   "title": "Arterial Blood Gases (ABGs)",
   "category": "Reference",
   "icon": "lungs",
   "summary": "Normal values and a fast method to interpret any ABG.",
   "sections": [
    {
     "h": "Normal values",
     "rows": [
      {
       "k": "pH",
       "v": "7.35–7.45",
       "note": "<7.35 acidosis, >7.45 alkalosis."
      },
      {
       "k": "PaCO₂",
       "v": "35–45 mmHg",
       "note": "The RESPIRATORY component (lungs)."
      },
      {
       "k": "HCO₃⁻",
       "v": "22–26 mEq/L",
       "note": "The METABOLIC component (kidneys)."
      },
      {
       "k": "PaO₂",
       "v": "80–100 mmHg",
       "note": "Oxygenation."
      },
      {
       "k": "SaO₂",
       "v": "95–100%",
       "note": "Oxygen saturation."
      }
     ]
    },
    {
     "h": "ROME — the shortcut",
     "rows": [
      {
       "k": "Respiratory",
       "v": "Opposite",
       "note": "pH and CO₂ move OPPOSITE ways (pH↓ CO₂↑ = respiratory acidosis)."
      },
      {
       "k": "Metabolic",
       "v": "Equal",
       "note": "pH and HCO₃ move the SAME way (pH↓ HCO₃↓ = metabolic acidosis)."
      }
     ]
    },
    {
     "h": "Steps",
     "rows": [
      {
       "k": "1. Look at pH",
       "v": "Acid or alkalotic?",
       "note": "Below 7.35 = acidosis; above 7.45 = alkalosis."
      },
      {
       "k": "2. Look at CO₂ and HCO₃",
       "v": "Which matches the pH?",
       "note": "CO₂ matches → respiratory. HCO₃ matches → metabolic."
      },
      {
       "k": "3. Check compensation",
       "v": "Is the other value shifting?",
       "note": "If the opposite system is moving to fix the pH, it's compensating."
      }
     ]
    }
   ],
   "pearl": "Common causes — Respiratory acidosis: hypoventilation/COPD. Respiratory alkalosis: hyperventilation. Metabolic acidosis: DKA, diarrhea. Metabolic alkalosis: vomiting, antacids."
  },
  {
   "id": "fluid-electrolytes",
   "title": "Fluid & Electrolyte Imbalances",
   "category": "Reference",
   "icon": "drop",
   "summary": "Quick signs of the imbalances most tested on the NCLEX.",
   "sections": [
    {
     "h": "Potassium",
     "rows": [
      {
       "k": "Hypokalemia (<3.5)",
       "v": "Muscle weakness, flat T waves, U waves",
       "note": "Common with loop/thiazide diuretics and vomiting."
      },
      {
       "k": "Hyperkalemia (>5.0)",
       "v": "Peaked T waves, weakness → dysrhythmias",
       "note": "Emergency: calcium gluconate protects the heart; insulin+D50 shift K⁺ in."
      }
     ]
    },
    {
     "h": "Sodium",
     "rows": [
      {
       "k": "Hyponatremia (<135)",
       "v": "Confusion, headache, seizures",
       "note": "Caused by fluid overload, SIADH."
      },
      {
       "k": "Hypernatremia (>145)",
       "v": "Thirst, dry mucosa, restlessness",
       "note": "Caused by dehydration, diabetes insipidus."
      }
     ]
    },
    {
     "h": "Calcium",
     "rows": [
      {
       "k": "Hypocalcemia (<9.0)",
       "v": "Tetany, Chvostek & Trousseau signs, tingling",
       "note": "Watch after thyroidectomy."
      },
      {
       "k": "Hypercalcemia (>10.5)",
       "v": "Muscle weakness, kidney stones, constipation",
       "note": "Caused by hyperparathyroidism, immobility."
      }
     ]
    },
    {
     "h": "Magnesium",
     "rows": [
      {
       "k": "Hypomagnesemia (<1.5)",
       "v": "Tremors, hyperreflexia, torsades",
       "note": "Often with alcohol use, malnutrition."
      },
      {
       "k": "Hypermagnesemia (>2.5)",
       "v": "Lost deep tendon reflexes, respiratory depression",
       "note": "Antidote is calcium gluconate."
      }
     ]
    }
   ],
   "pearl": "Fluid deficit = dry, low BP, fast weak pulse. Fluid excess = crackles, edema, JVD, bounding pulse, weight gain."
  },
  {
   "id": "vital-signs",
   "title": "Normal Vital Signs by Age",
   "category": "Reference",
   "icon": "heartbeat",
   "summary": "Age-based normal ranges — the numbers that flag a sick pediatric client.",
   "sections": [
    {
     "h": "Heart rate (beats/min)",
     "rows": [
      {
       "k": "Newborn",
       "v": "100–160",
       "note": "Assess apically for a full minute."
      },
      {
       "k": "Infant / Toddler",
       "v": "90–150",
       "note": "Falls as the child grows."
      },
      {
       "k": "Preschool / School-age",
       "v": "70–120",
       "note": "Approaches adult range."
      },
      {
       "k": "Adolescent / Adult",
       "v": "60–100",
       "note": "Athletes may be lower."
      }
     ]
    },
    {
     "h": "Respiratory rate (breaths/min)",
     "rows": [
      {
       "k": "Newborn",
       "v": "30–60",
       "note": "Count for a full minute; irregular is common."
      },
      {
       "k": "Infant / Toddler",
       "v": "24–40",
       "note": ""
      },
      {
       "k": "Preschool / School-age",
       "v": "18–30",
       "note": ""
      },
      {
       "k": "Adult",
       "v": "12–20",
       "note": ""
      }
     ]
    },
    {
     "h": "Blood pressure (systolic, mmHg)",
     "rows": [
      {
       "k": "Newborn",
       "v": "~60–90",
       "note": "Low BP is a LATE sign of shock in children."
      },
      {
       "k": "Toddler / Preschool",
       "v": "~80–110",
       "note": ""
      },
      {
       "k": "School-age / Adult",
       "v": "~90–120",
       "note": "Adult hypertension ≥130/80."
      }
     ]
    },
    {
     "h": "Temperature",
     "rows": [
      {
       "k": "Normal (oral)",
       "v": "36.5–37.5°C (97.7–99.5°F)",
       "note": "Route affects the reading (rectal higher, axillary lower)."
      }
     ]
    }
   ],
   "pearl": "In children, a rising heart rate and respiratory rate come FIRST; a falling blood pressure is a late, ominous sign of shock."
  },
  {
