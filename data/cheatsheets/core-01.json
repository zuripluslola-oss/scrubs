       "note": "Use cautiously — can trigger seizures."
      },
      {
       "k": "Acetaminophen",
       "v": "Acetylcysteine (Mucomyst)",
       "note": "Prevents liver failure if given early."
      }
     ]
    },
    {
     "h": "Cardiac / other",
     "rows": [
      {
       "k": "Digoxin",
       "v": "Digoxin immune Fab (DigiFab)",
       "note": "For severe toxicity."
      },
      {
       "k": "Magnesium sulfate",
       "v": "Calcium gluconate",
       "note": "For magnesium toxicity (lost reflexes, resp. depression)."
      },
      {
       "k": "Iron",
       "v": "Deferoxamine",
       "note": "Chelates excess iron."
      },
      {
       "k": "Beta-blocker",
       "v": "Glucagon",
       "note": "For symptomatic overdose."
      }
     ]
    }
   ],
   "pearl": "If a question gives a toxic drug level plus symptoms, the answer is almost always: hold the drug and give the antidote."
  },
