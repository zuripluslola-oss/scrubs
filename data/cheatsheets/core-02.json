{
 "batch": "core-02",
 "sheets": [
  {
   "id": "insulin-types",
   "title": "Insulin Types (Onset / Peak / Duration)",
   "category": "Pharmacology",
   "icon": "flask",
   "summary": "When each insulin works — the timing that drives hypoglycemia questions.",
   "sections": [
    {
     "h": "Rapid-acting (lispro, aspart, glulisine)",
     "rows": [
      {
       "k": "Onset",
       "v": "10–15 min",
       "note": "Give WITH the meal (food must be in front of the client)."
      },
      {
       "k": "Peak",
       "v": "1 hour",
       "note": "Watch for hypoglycemia ~1 hr after."
      },
      {
       "k": "Duration",
       "v": "2–4 hours",
       "note": ""
      }
     ]
    },
    {
     "h": "Short-acting (regular)",
     "rows": [
      {
       "k": "Onset",
       "v": "30–60 min",
       "note": "The ONLY insulin that can be given IV."
      },
      {
       "k": "Peak",
       "v": "2–4 hours",
       "note": "Hypoglycemia most likely here."
      },
      {
       "k": "Duration",
       "v": "5–8 hours",
       "note": ""
      }
     ]
    },
    {
     "h": "Intermediate (NPH)",
     "rows": [
      {
       "k": "Onset",
       "v": "1–2 hours",
       "note": "Cloudy — gently roll to mix, never IV."
      },
      {
       "k": "Peak",
       "v": "4–12 hours",
       "note": "Wide peak — teach the client when lows may occur."
      },
      {
       "k": "Duration",
       "v": "12–18 hours",
       "note": ""
      }
     ]
    },
    {
     "h": "Long-acting (glargine, detemir)",
     "rows": [
      {
       "k": "Onset",
       "v": "1–2 hours",
       "note": "Basal coverage — do NOT mix with other insulins."
      },
      {
       "k": "Peak",
       "v": "No pronounced peak",
       "note": "Steady release."
      },
      {
       "k": "Duration",
       "v": "~24 hours",
       "note": "Usually once daily."
      }
     ]
    }
   ],
   "pearl": "Mixing insulins: draw up CLEAR before CLOUDY (regular before NPH). Only regular insulin goes IV."
  },
  {
   "id": "dysrhythmias",
   "title": "Common Dysrhythmias",
   "category": "Cardiac",
   "icon": "heartbeat",
   "summary": "Recognize the rhythm and the action it demands.",
   "sections": [
    {
     "h": "Normal & sinus",
     "rows": [
      {
       "k": "Normal sinus rhythm",
       "v": "60–100, P before each QRS",
       "note": "The baseline."
      },
      {
       "k": "Sinus bradycardia",
       "v": "<60, regular",
       "note": "Treat if symptomatic: atropine."
      },
      {
       "k": "Sinus tachycardia",
       "v": ">100, regular",
       "note": "Treat the cause (fever, pain, hypovolemia)."
      }
     ]
    },
    {
     "h": "Atrial",
     "rows": [
      {
       "k": "Atrial fibrillation",
       "v": "Irregularly irregular, no P waves",
       "note": "Risk of clots/stroke → anticoagulate; control rate."
      },
      {
       "k": "Atrial flutter",
       "v": "Sawtooth flutter waves",
       "note": "Similar clot risk; rate control."
      },
      {
       "k": "SVT",
       "v": "Fast, narrow, regular",
       "note": "Vagal maneuvers, then adenosine."
      }
     ]
    },
    {
     "h": "Ventricular (dangerous)",
     "rows": [
      {
       "k": "Ventricular tachycardia",
       "v": "Wide, regular, fast",
       "note": "Pulse + unstable → cardiovert. Pulseless → defibrillate + CPR."
      },
      {
       "k": "Ventricular fibrillation",
       "v": "Chaotic, no complexes",
       "note": "Defibrillate immediately + CPR."
      },
      {
       "k": "Asystole",
       "v": "Flat line",
       "note": "CPR + epinephrine — NOT shockable."
      }
     ]
    }
   ],
   "pearl": "Shockable = VF and pulseless VT. NOT shockable = asystole and PEA (do CPR + epinephrine)."
  },
  {
   "id": "positioning",
   "title": "Client Positioning",
   "category": "Reference",
   "icon": "sheet",
   "summary": "The right position for the condition or procedure.",
   "sections": [
    {
     "h": "Respiratory / cardiac",
     "rows": [
      {
       "k": "High/semi-Fowler's",
       "v": "Head of bed up",
       "note": "Dyspnea, heart failure, after meals, tube feeding."
      },
      {
       "k": "Tripod / upright",
       "v": "Leaning forward",
       "note": "Respiratory distress, epiglottitis (keep calm)."
      }
     ]
    },
    {
     "h": "Emergencies",
     "rows": [
      {
       "k": "Left lateral Trendelenburg",
       "v": "Left side, head down",
       "note": "Suspected air embolism (traps air in right atrium)."
      },
      {
       "k": "Modified Trendelenburg",
       "v": "Legs elevated, torso flat",
       "note": "Hypovolemic shock."
      },
      {
       "k": "Flat / side-lying",
       "v": "—",
       "note": "Seizure & unconscious: side-lying to protect airway."
      }
     ]
    },
    {
     "h": "Post-procedure",
     "rows": [
      {
       "k": "Supine, flat",
       "v": "Lie flat",
       "note": "After spinal anesthesia/some lumbar punctures (per policy)."
      },
      {
       "k": "Right side-lying",
       "v": "Pressure on site",
       "note": "After liver biopsy — apply pressure."
      },
      {
       "k": "Prone",
       "v": "Face down",
       "note": "ARDS — improves oxygenation."
      },
      {
       "k": "Sit up (High-Fowler's)",
       "v": "Upright",
       "note": "Autonomic dysreflexia — raise the head immediately."
      }
     ]
    }
   ],
   "pearl": "Air embolism = LEFT side, head DOWN. Autonomic dysreflexia = sit UP. Post-op unconscious = side-lying."
  },
  {
   "id": "ob-quick-ref",
   "title": "OB / Maternity Quick Reference",
   "category": "Maternity",
   "icon": "drop",
   "summary": "The acronyms and stages that anchor maternity questions.",
   "sections": [
    {
     "h": "APGAR (1 & 5 min, 0–2 each)",
     "rows": [
      {
       "k": "A",
       "v": "Appearance (color)",
       "note": "Score 7–10 = good; 4–6 = moderate distress; 0–3 = severe."
      },
      {
       "k": "P",
       "v": "Pulse (heart rate)",
       "note": "Absent=0, <100=1, >100=2 (most important sign)."
      },
      {
       "k": "G",
       "v": "Grimace (reflex)",
       "note": ""
      },
      {
       "k": "A",
       "v": "Activity (muscle tone)",
       "note": ""
      },
      {
       "k": "R",
       "v": "Respiratory effort",
       "note": ""
      }
     ]
    },
    {
     "h": "VEAL CHOP (fetal decels)",
     "rows": [
      {
       "k": "Variable",
       "v": "Cord compression",
       "note": "Reposition mother; check for prolapse."
      },
      {
       "k": "Early",
       "v": "Head compression",
       "note": "Benign — no action needed."
      },
      {
       "k": "Accelerations",
       "v": "OK / reassuring",
       "note": "A sign of fetal well-being."
      },
      {
       "k": "Late",
       "v": "Placental insufficiency",
       "note": "Non-reassuring: stop oxytocin, reposition, O₂, IV, notify."
      }
     ]
    },
    {
     "h": "Stages of labor",
     "rows": [
      {
       "k": "1st stage",
       "v": "Onset to full dilation (10 cm)",
       "note": "Longest stage."
      },
      {
       "k": "2nd stage",
       "v": "Full dilation to birth",
       "note": "Pushing."
      },
      {
       "k": "3rd stage",
       "v": "Birth to placenta delivery",
       "note": ""
      },
      {
       "k": "4th stage",
       "v": "First 1–4 hr after birth",
       "note": "Recovery; watch for hemorrhage (boggy uterus)."
      }
     ]
    }
   ],
   "pearl": "GTPAL = Gravida (pregnancies), Term, Preterm, Abortions/losses, Living children."
  },
  {
   "id": "diabetic-emergencies",
   "title": "Diabetic Emergencies",
   "category": "Endocrine",
   "icon": "drop",
   "summary": "Telling hypoglycemia, DKA, and HHS apart — and what to do.",
   "sections": [
    {
     "h": "Hypoglycemia (<70 mg/dL)",
     "rows": [
      {
       "k": "Signs",
       "v": "Shaky, sweaty, confused, tachycardia",
       "note": "Rapid onset — cold and clammy = give candy."
      },
      {
       "k": "Treat",
       "v": "Rule of 15: 15 g fast carbs, recheck in 15 min",
       "note": "If unconscious: IV dextrose or glucagon."
      }
     ]
    },
    {
     "h": "DKA (Type 1, glucose >250)",
     "rows": [
      {
       "k": "Signs",
       "v": "Kussmaul breathing, fruity breath, ketones, acidosis",
       "note": "Hot and dry = sugar high."
      },
      {
       "k": "Treat",
       "v": "IV fluids first → insulin → replace potassium",
       "note": "Insulin drives K⁺ into cells (watch for hypokalemia)."
      }
     ]
    },
    {
     "h": "HHS (Type 2, glucose >600)",
     "rows": [
      {
       "k": "Signs",
       "v": "Severe dehydration, altered LOC, NO ketones",
       "note": "Higher glucose than DKA, no significant acidosis."
      },
      {
       "k": "Treat",
       "v": "Aggressive IV fluids + insulin",
       "note": "Slower correction to avoid cerebral edema."
      }
     ]
    }
   ],
   "pearl": "\"Cold & clammy → need candy (low). Hot & dry → sugar high.\" DKA/HHS both start with FLUIDS."
  },
  {
   "id": "shock-types",
   "title": "Types of Shock",
   "category": "Reference",
   "icon": "drop",
   "summary": "The four categories and the fix for each.",
   "sections": [
    {
     "h": "The types",
     "rows": [
      {
       "k": "Hypovolemic",
       "v": "Fluid/blood loss",
       "note": "Hemorrhage, dehydration → replace fluids/blood."
      },
      {
       "k": "Cardiogenic",
       "v": "Pump failure",
       "note": "MI, heart failure → support the pump (inotropes)."
      },
      {
       "k": "Distributive",
       "v": "Massive vasodilation",
       "note": "Septic, anaphylactic, neurogenic → vasopressors + treat cause."
      },
      {
       "k": "Obstructive",
       "v": "Blocked flow",
       "note": "PE, cardiac tamponade, tension pneumothorax → relieve the obstruction."
      }
     ]
    },
    {
     "h": "Shared late signs",
     "rows": [
      {
       "k": "All shock",
       "v": "↓BP, ↑HR, ↓urine output, altered LOC",
       "note": "Cool/clammy (except early warm phase of septic/neurogenic)."
      }
     ]
    }
   ],
   "pearl": "Rising heart rate and falling urine output are early. A dropping blood pressure is a LATE, ominous sign."
  },
  {
   "id": "therapeutic-communication",
   "title": "Therapeutic Communication",
   "category": "Mental Health",
   "icon": "chat",
   "summary": "What to say — and what shuts a client down.",
   "sections": [
    {
     "h": "Use these",
     "rows": [
      {
       "k": "Open-ended questions",
       "v": "“Tell me more about that.”",
       "note": "Invites the client to share."
      },
      {
       "k": "Reflecting / restating",
       "v": "“You’re feeling overwhelmed.”",
       "note": "Shows empathy, focuses on feelings."
      },
      {
       "k": "Silence",
       "v": "Allow pauses",
       "note": "Gives the client time to process."
      },
      {
       "k": "Clarifying",
       "v": "“What do you mean by…?”",
       "note": "Ensures understanding."
      },
      {
       "k": "Offering self",
       "v": "“I’ll sit with you.”",
       "note": "Presence without conditions."
      }
     ]
    },
    {
     "h": "Avoid these",
     "rows": [
      {
       "k": "False reassurance",
       "v": "“Everything will be fine.”",
       "note": "Dismisses real feelings."
      },
      {
       "k": "Why questions",
       "v": "“Why did you do that?”",
       "note": "Feels confrontational."
      },
      {
       "k": "Giving advice",
       "v": "“If I were you…”",
       "note": "Removes client autonomy."
      },
      {
       "k": "Changing the subject",
       "v": "—",
       "note": "Signals discomfort, blocks trust."
      },
      {
       "k": "Closed questions",
       "v": "Yes/no only",
       "note": "Shuts down disclosure."
      }
     ]
    }
   ],
   "pearl": "Therapeutic answers reflect FEELINGS and keep the focus on the client — not advice, reassurance, or 'why.'"
  },
  {
   "id": "drug-suffixes",
   "title": "Drug Class Suffixes",
   "category": "Pharmacology",
   "icon": "flask",
   "summary": "Decode a drug's class from its ending — and its key warning.",
   "sections": [
    {
     "h": "Cardiovascular",
     "rows": [
      {
       "k": "-pril",
       "v": "ACE inhibitors (lisinopril)",
       "note": "Dry cough, angioedema, hyperkalemia."
      },
      {
       "k": "-sartan",
       "v": "ARBs (losartan)",
       "note": "Like ACE without the cough."
      },
      {
       "k": "-olol",
       "v": "Beta-blockers (metoprolol)",
       "note": "Hold if HR <60; don't stop abruptly."
      },
      {
       "k": "-dipine",
       "v": "Calcium channel blockers (amlodipine)",
       "note": "Peripheral edema."
      },
      {
       "k": "-statin",
       "v": "Cholesterol (atorvastatin)",
       "note": "Report muscle pain (rhabdomyolysis)."
      }
     ]
    },
    {
     "h": "GI & antimicrobial",
     "rows": [
      {
       "k": "-prazole",
       "v": "Proton pump inhibitors (omeprazole)",
       "note": "Take before meals."
      },
      {
       "k": "-cillin",
       "v": "Penicillins (amoxicillin)",
       "note": "Ask about allergy."
      },
      {
       "k": "-floxacin",
       "v": "Fluoroquinolones (ciprofloxacin)",
       "note": "Tendon rupture risk."
      },
      {
       "k": "-mycin",
       "v": "Aminoglycosides (gentamicin)",
       "note": "Nephrotoxic + ototoxic."
      }
     ]
    },
    {
     "h": "CNS",
     "rows": [
      {
       "k": "-pam / -lam",
       "v": "Benzodiazepines (lorazepam)",
       "note": "CNS/respiratory depression; antidote flumazenil."
      },
      {
       "k": "-barbital",
       "v": "Barbiturates",
       "note": "Sedation, respiratory depression."
      }
     ]
    }
   ],
   "pearl": "Suffix tells the class; the class tells the warning. -pril = cough, -olol = hold for low HR, -statin = muscle pain."
  },
  {
   "id": "heart-failure",
   "title": "Heart Failure: Left vs Right",
   "category": "Cardiac",
   "icon": "heartbeat",
   "summary": "Which side fails, and where the fluid backs up.",
   "sections": [
    {
     "h": "Left-sided (Left = Lungs)",
     "rows": [
      {
       "k": "Where fluid backs up",
       "v": "Into the lungs",
       "note": "Pulmonary congestion."
      },
      {
       "k": "Signs",
       "v": "Crackles, dyspnea, orthopnea, frothy/pink sputum",
       "note": "Trouble breathing, especially lying flat."
      }
     ]
    },
    {
     "h": "Right-sided (Right = Rest of body)",
     "rows": [
      {
       "k": "Where fluid backs up",
       "v": "Into the systemic circulation",
       "note": "Venous congestion."
      },
      {
       "k": "Signs",
       "v": "JVD, peripheral edema, ascites, weight gain, hepatomegaly",
       "note": "Swelling you can see and weigh."
      }
     ]
    },
    {
     "h": "Both",
     "rows": [
      {
       "k": "Monitoring",
       "v": "Daily weight, I&O, low sodium",
       "note": "Report a 2–3 lb gain in a day."
      }
     ]
    }
   ],
   "pearl": "LEFT = Lungs (crackles, dyspnea). RIGHT = Rest of body (edema, JVD, weight gain)."
  },
