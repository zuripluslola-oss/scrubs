# Must Love Scrubs — environment variables.
# Copy this file to `web/.env` and fill in your values. NEVER commit `.env`.

# ── Supabase ──────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Settings → API → service_role (SECRET — server only, never sent to the browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database connection string. Supabase: Settings → Database → Connection string
# (use the "URI" / pooled connection for serverless). Prisma reads this.
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require"

# ── AI (Esi tutor + question generation) ──────────────────────────────
# platform.openai.com → API keys. This is the one guaranteed monthly cost.
OPENAI_API_KEY="sk-your-openai-key"
# Optional: use Anthropic instead/also
# ANTHROPIC_API_KEY="sk-ant-your-key"

# ── Stripe (ONLY when you start selling subscriptions — skip for now) ──
# STRIPE_SECRET_KEY="sk_live_or_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_or_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
