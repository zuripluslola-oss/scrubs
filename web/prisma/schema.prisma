// Must Love Scrubs — data model.
// Postgres (via Supabase). JSON columns hold the flexible NGN shapes
// (options, matrix rows, bow-tie groups) so every item type fits one table.
// Run: npx prisma migrate deploy   then   node scripts/import-content.mjs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id         String       @id @default(uuid())
  email      String       @unique
  name       String?
  role       Role         @default(STUDENT)
  createdAt  DateTime     @default(now())
  attempts   Attempt[]
  sessions   ExamSession[]
  mastery    Mastery[]
  plans      StudyPlan[]
}

// One row per question, every item type. Type-specific data lives in JSON.
model Question {
  id         String    @id
  exam       String    // "RN" | "PN"
  cat        String    // clinical area
  topic      String?
  difficulty String    // "Easy" | "Moderate" | "Hard"
  level      Int       @default(3) // 1..5 for the CAT engine
  type       String    // "mc" | "sata" | "matrix" | "bowtie" | ...
  stem       String
  free       Boolean   @default(false)
  // flexible payloads per type:
  opts       Json?     // mc/sata: [{t, r}]
  correct    Json?     // mc: int; sata: int[]
  cols       Json?     // matrix column labels
  rows       Json?     // matrix rows: [{t, correct, r}]
  condition  Json?     // bowtie
  actions    Json?     // bowtie
  parameters Json?     // bowtie
  tip        String?
  pearl      String?
  attempts   Attempt[]

  @@index([cat])
  @@index([type])
}

model Flashcard {
  id         String  @id
  kind       String  @default("qa") // qa | mc | tf | fill | odd | order | bowtie
  deck       String
  topic      String?
  difficulty Int     @default(3)
  front      String
  back       String?
  rationale  String?
  hint       String?
  data       Json?   // type-specific (options, correct, items, etc.)

  @@index([deck])
}

model Drug {
  id        String  @id
  generic   String
  brand     String?
  drugClass String  // "class" is reserved; mapped below
  system    String
  moa       String
  uses      Json    // string[]
  dose      String
  route     String
  side      Json    // string[]
  adverse   Json    // string[]
  nursing   Json    // string[]
  labs      Json    // string[]
  contra    Json    // string[]
  teaching  Json    // string[]
  antidote  String  @default("None")
  highalert Boolean @default(false)
  prototype Boolean @default(false)
  tip       String?
  pearl     String?

  @@map("drugs")
  @@index([system])
}

// Every answered question (drives analytics, mastery, spaced review).
model Attempt {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
  correct    Boolean
  chosen     Json?    // what the user picked
  timeMs     Int?
  confidence Int?     // optional 1..5
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([questionId])
}

// A test/exam run (quiz, basic, adaptive NCLEX mock, specialty).
model ExamSession {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  mode      String    // "quiz" | "basic" | "nclex" | "specialty"
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  ability   Float?    // final theta / ability estimate
  itemCount Int       @default(0)
  score     Int?      // percent
  verdict   String?   // "pass" | "border" | "fail"
  meta      Json?     // per-topic breakdown, etc.

  @@index([userId])
}

// Rolling mastery per topic, per user (feeds adaptive selection + study plan).
model Mastery {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  topic     String
  correct   Int      @default(0)
  total     Int      @default(0)
  level     Float    @default(3)
  updatedAt DateTime @updatedAt

  @@unique([userId, topic])
}

model StudyPlan {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  lengthMo  Int      // 1 | 2 | 3 | 6
  startDate DateTime
  done      Json?    // { "2026-07-20": true, ... }
  createdAt DateTime @default(now())

  @@index([userId])
}
